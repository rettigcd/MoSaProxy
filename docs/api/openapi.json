{
  "openapi": "3.1.1",
  "info": {
    "title": "MoSaProxy local API",
    "description": "Read what the proxy captured and switch capture on and off.",
    "version": "1"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "How the proxy is set up and what it has captured",
        "description": "The proxy's port, whether it intercepts HTTPS and offers HTTP/2, whether capture is on, how many exchanges are captured, and the capture folder and log file.",
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/capture": {
      "get": {
        "tags": [
          "Capture"
        ],
        "summary": "Whether capture is on",
        "description": "While capture is off, traffic is still forwarded and logged; only the captured exchanges stop growing.",
        "operationId": "GetCapture",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiCaptureState"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Capture"
        ],
        "summary": "Turn capture on or off",
        "description": "An exchange already running is not affected: it is captured to its end if it began while capture was on, and not at all if it began while off.",
        "operationId": "SetCapture",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiCaptureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiCaptureState"
                }
              }
            }
          }
        }
      }
    },
    "/api/exchanges": {
      "get": {
        "tags": [
          "Exchanges"
        ],
        "summary": "A page of captured exchanges, oldest first",
        "description": "Only exchanges that have finished are listed. Pass the previous page's next value as after to get the following page, or the highest number already seen to get what is new. host, mode and q match text contained in the value (any case); method must match exactly (any case).",
        "operationId": "ListExchanges",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "host",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "method",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiExchangePage"
                }
              }
            }
          }
        }
      }
    },
    "/api/exchanges/{id}": {
      "get": {
        "tags": [
          "Exchanges"
        ],
        "summary": "One captured exchange",
        "description": "The summary, the request and response heads with their headers in the order captured, timings, where the captured bytes came from, and whether a WebSocket log exists.",
        "operationId": "GetExchange",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiCaptureRequest": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ApiCaptureState": {
        "required": [
          "enabled",
          "exchangesCaptured"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "exchangesCaptured": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ApiExchangePage": {
        "required": [
          "items",
          "next"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExchangeSummary"
            }
          },
          "next": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ApiStatus": {
        "required": [
          "version",
          "proxyPort",
          "intercept",
          "http2",
          "captureEnabled",
          "exchangesCaptured",
          "captureFolder",
          "logFile"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "proxyPort": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "intercept": {
            "type": "boolean"
          },
          "http2": {
            "type": "boolean"
          },
          "captureEnabled": {
            "type": "boolean"
          },
          "exchangesCaptured": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "captureFolder": {
            "type": [
              "null",
              "string"
            ]
          },
          "logFile": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExchangeDetail": {
        "required": [
          "summary",
          "client",
          "clientPort",
          "clientTlsVersion",
          "clientConnectionReused",
          "originConnectionReused",
          "originConnectionId",
          "clientMessages",
          "originMessages",
          "requestSource",
          "responseSource",
          "requestBodyTruncated",
          "responseBodyTruncated",
          "times",
          "request",
          "response",
          "hasWebSocketLog"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/ExchangeSummary"
          },
          "client": {
            "type": "string"
          },
          "clientPort": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "clientTlsVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientConnectionReused": {
            "type": "boolean"
          },
          "originConnectionReused": {
            "type": "boolean"
          },
          "originConnectionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "clientMessages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "originMessages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "requestSource": {
            "type": "string"
          },
          "responseSource": {
            "type": "string"
          },
          "requestBodyTruncated": {
            "type": "boolean"
          },
          "responseBodyTruncated": {
            "type": "boolean"
          },
          "times": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "date-time"
            }
          },
          "request": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HttpHead"
              }
            ]
          },
          "response": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HttpHead"
              }
            ]
          },
          "hasWebSocketLog": {
            "type": "boolean"
          }
        }
      },
      "ExchangeSummary": {
        "required": [
          "id",
          "timestamp",
          "method",
          "scheme",
          "host",
          "port",
          "path",
          "url",
          "status",
          "clientHttpVersion",
          "originHttpVersion",
          "mode",
          "requestBytes",
          "responseBytes",
          "durationMs",
          "error"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "type": "string"
          },
          "scheme": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "clientHttpVersion": {
            "type": "string"
          },
          "originHttpVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "mode": {
            "type": "string"
          },
          "requestBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "responseBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "durationMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HttpHead": {
        "required": [
          "firstLine",
          "headers"
        ],
        "type": "object",
        "properties": {
          "firstLine": {
            "type": "string"
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyValuePairOfstringAndstring"
            }
          }
        }
      },
      "KeyValuePairOfstringAndstring": {
        "required": [
          "key",
          "value"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": [
              "null",
              "string"
            ]
          },
          "value": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Status"
    },
    {
      "name": "Capture"
    },
    {
      "name": "Exchanges"
    }
  ]
}
